{
  "contract_version": "v1",
  "item_id": "item-sample-0001",
  "tool": {
    "slug": "sample-rate-buildup",
    "title": "Sample hourly rate build-up",
    "summary": "Builds a made-up hourly rate from a base rate, add-on percentages and a fee, one step at a time. Every rule and number in it is invented to exercise the calculator template."
  },
  "pattern": "calculator",
  "citations": [
    {
      "id": "rule_fringe",
      "label": "Sample Rule 12.3(a) (fictional)",
      "note": "Sets the made-up fringe percentage",
      "url": "https://rules.example/sample-rule-12-3"
    },
    {
      "id": "rule_overhead",
      "label": "Sample Rule 12.3(b) (fictional)",
      "note": "Sets the made-up overhead percentage and what it applies to"
    },
    {
      "id": "rule_fee",
      "label": "Sample Rule 12.4 (fictional)",
      "note": "Sets the made-up fee tiers and the cap on the fee"
    },
    {
      "id": "rule_floor",
      "label": "Sample Rule 12.5 (fictional)",
      "note": "Sets the made-up minimum billable rate"
    }
  ],
  "scope_limits": [
    "Every rule, rate and threshold here is fictional. Do not use the result for a real proposal, invoice or contract.",
    "It covers one labour category at a time and does not add travel, materials or other direct costs.",
    "It does not check whether a rate is allowable under any real regulation."
  ],
  "body": {
    "inputs": [
      {
        "id": "base_rate",
        "label": "Base hourly rate",
        "kind": "number",
        "help": "The rate paid for one hour of work, before anything is added.",
        "unit": "per hour",
        "decimals": 2,
        "min": "0.00",
        "max": "500.00",
        "default": "40.00"
      },
      {
        "id": "hours",
        "label": "Hours of work",
        "kind": "number",
        "unit": "hours",
        "decimals": 1,
        "min": "0",
        "max": "10000",
        "default": "100"
      },
      {
        "id": "fee_tier",
        "label": "Fee tier",
        "kind": "choice",
        "table": "fee_tiers",
        "default": "standard"
      }
    ],
    "constants": [
      {
        "id": "fringe_pct",
        "label": "Fringe percentage",
        "value": "32.5",
        "unit": "percent",
        "citation": "rule_fringe"
      },
      {
        "id": "overhead_pct",
        "label": "Overhead percentage",
        "value": "18.25",
        "unit": "percent",
        "citation": "rule_overhead"
      },
      {
        "id": "fee_cap",
        "label": "Largest fee allowed",
        "value": "5.00",
        "unit": "per hour",
        "citation": "rule_fee"
      },
      {
        "id": "floor_rate",
        "label": "Minimum billable rate",
        "value": "60.00",
        "unit": "per hour",
        "citation": "rule_floor"
      },
      {
        "id": "hours_per_day",
        "label": "Hours in a working day",
        "value": "0",
        "unit": "hours"
      }
    ],
    "tables": [
      {
        "id": "fee_tiers",
        "label": "Fee tiers",
        "unit": "percent",
        "citation": "rule_fee",
        "rows": [
          {
            "key": "low",
            "label": "Low risk",
            "value": "5.0"
          },
          {
            "key": "standard",
            "label": "Standard",
            "value": "7.5"
          },
          {
            "key": "high",
            "label": "High risk",
            "value": "10.0"
          }
        ]
      }
    ],
    "steps": [
      {
        "id": "fringe",
        "label": "Fringe",
        "op": "pct",
        "args": [
          "base_rate",
          "fringe_pct"
        ],
        "decimals": 2,
        "unit": "per hour",
        "citation": "rule_fringe"
      },
      {
        "id": "overhead_base",
        "label": "Rate with fringe",
        "op": "add",
        "args": [
          "base_rate",
          "fringe"
        ],
        "decimals": 2,
        "unit": "per hour",
        "citation": "rule_overhead"
      },
      {
        "id": "overhead",
        "label": "Overhead",
        "op": "pct",
        "args": [
          "overhead_base",
          "overhead_pct"
        ],
        "decimals": 2,
        "unit": "per hour",
        "citation": "rule_overhead"
      },
      {
        "id": "cost_rate",
        "label": "Cost rate",
        "op": "add",
        "args": [
          "base_rate",
          "fringe",
          "overhead"
        ],
        "decimals": 2,
        "unit": "per hour"
      },
      {
        "id": "fee_uncapped",
        "label": "Fee before the cap",
        "op": "pct",
        "args": [
          "cost_rate",
          "fee_tier"
        ],
        "decimals": 2,
        "unit": "per hour",
        "citation": "rule_fee"
      },
      {
        "id": "fee",
        "label": "Fee",
        "op": "min",
        "args": [
          "fee_uncapped",
          "fee_cap"
        ],
        "decimals": 2,
        "unit": "per hour",
        "citation": "rule_fee"
      },
      {
        "id": "loaded_rate",
        "label": "Loaded rate",
        "op": "add",
        "args": [
          "cost_rate",
          "fee"
        ],
        "decimals": 2,
        "unit": "per hour"
      },
      {
        "id": "above_floor",
        "label": "Loaded rate above the minimum",
        "op": "sub",
        "args": [
          "loaded_rate",
          "floor_rate"
        ],
        "decimals": 2,
        "unit": "per hour",
        "citation": "rule_floor"
      },
      {
        "id": "billable_rate",
        "label": "Billable rate",
        "op": "max",
        "args": [
          "loaded_rate",
          "floor_rate"
        ],
        "decimals": 2,
        "unit": "per hour",
        "citation": "rule_floor"
      },
      {
        "id": "total",
        "label": "Total for the hours",
        "op": "mul",
        "args": [
          "billable_rate",
          "hours"
        ],
        "decimals": 2
      },
      {
        "id": "days",
        "label": "Working days",
        "op": "div",
        "args": [
          "hours",
          "hours_per_day"
        ],
        "decimals": 1,
        "unit": "days"
      }
    ],
    "outputs": [
      "billable_rate",
      "total"
    ]
  },
  "worked_examples": [
    {
      "id": "starting_values",
      "label": "The starting values: 40.00 an hour, 100 hours, standard fee tier",
      "inputs": {
        "base_rate": "40.00",
        "hours": "100",
        "fee_tier": "standard"
      },
      "expect": {
        "fringe": "13.00",
        "overhead_base": "53.00",
        "overhead": "9.67",
        "cost_rate": "62.67",
        "fee_uncapped": "4.70",
        "fee": "4.70",
        "loaded_rate": "67.37",
        "above_floor": "7.37",
        "billable_rate": "67.37",
        "total": "6737.00",
        "days": "12.5"
      }
    },
    {
      "id": "fee_cap_applies",
      "label": "A high rate on the high-risk tier, where the fee cap applies",
      "inputs": {
        "base_rate": "123.45",
        "hours": "37.5",
        "fee_tier": "high"
      },
      "expect": {
        "fringe": "40.12",
        "overhead": "29.85",
        "cost_rate": "193.42",
        "fee_uncapped": "19.34",
        "fee": "5.00",
        "billable_rate": "198.42",
        "total": "7440.75",
        "days": "4.7"
      }
    },
    {
      "id": "floor_applies",
      "label": "A low rate, where the minimum billable rate applies",
      "inputs": {
        "base_rate": "30.00",
        "hours": "7.5",
        "fee_tier": "low"
      },
      "expect": {
        "fringe": "9.75",
        "overhead": "7.25",
        "cost_rate": "47.00",
        "fee": "2.35",
        "loaded_rate": "49.35",
        "above_floor": "-10.65",
        "billable_rate": "60.00",
        "total": "450.00",
        "days": "0.9"
      }
    },
    {
      "id": "all_zero",
      "label": "The lowest values allowed: nothing an hour and no hours",
      "inputs": {
        "base_rate": "0.00",
        "hours": "0",
        "fee_tier": "standard"
      },
      "expect": {
        "cost_rate": "0.00",
        "above_floor": "-60.00",
        "billable_rate": "60.00",
        "total": "0.00",
        "days": "0.0"
      }
    },
    {
      "id": "half_rounds_up",
      "label": "A rate chosen so that the fringe lands exactly on a half: 0.20 an hour",
      "inputs": {
        "base_rate": "0.20",
        "hours": "1",
        "fee_tier": "standard"
      },
      "expect": {
        "fringe": "0.07",
        "overhead": "0.05",
        "cost_rate": "0.32",
        "fee": "0.02",
        "billable_rate": "60.00",
        "total": "60.00",
        "days": "0.1"
      }
    }
  ]
}
