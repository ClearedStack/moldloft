<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<main>
<h1>{{.Title}}</h1>
<p class="lede">{{.Summary}}</p>

<section aria-labelledby="h-scope">
<h2 id="h-scope">What this tool does not cover</h2>
<ul>
{{- range .ScopeLimits}}
<li>{{.}}</li>
{{- end}}
</ul>
</section>

<section aria-labelledby="h-inputs">
<h2 id="h-inputs">Your values</h2>
<form id="inputs" novalidate autocomplete="off">
{{- range .Inputs}}
<div class="field">
<label for="in-{{.ID}}">{{.Label}}{{if .Unit}} <span class="unit">({{.Unit}})</span>{{end}}</label>
{{- if .Options}}
<select id="in-{{.ID}}" aria-describedby="hint-{{.ID}} err-{{.ID}}">
{{- range .Options}}
<option value="{{.Key}}"{{if .Selected}} selected{{end}}>{{.Label}} ({{.Value}})</option>
{{- end}}
</select>
{{- else}}
<input id="in-{{.ID}}" type="text" inputmode="decimal" value="{{.Default}}" aria-describedby="hint-{{.ID}} err-{{.ID}}">
{{- end}}
<p class="hint" id="hint-{{.ID}}">{{.Hint}}</p>
<p class="error" id="err-{{.ID}}" aria-live="polite"></p>
</div>
{{- end}}
<button type="reset">Put the starting values back</button>
</form>
</section>

<section aria-labelledby="h-totals">
<h2 id="h-totals">Result</h2>
<dl class="totals">
{{- range .Outputs}}
<div>
<dt>{{.Label}}{{if .Unit}} <span class="unit">({{.Unit}})</span>{{end}}</dt>
<dd id="total-{{.ID}}">-</dd>
</div>
{{- end}}
</dl>
<p class="hint" id="status" aria-live="polite">The result needs JavaScript and has not been worked out.</p>
</section>

<section aria-labelledby="h-steps">
<h2 id="h-steps">How the result is worked out</h2>
<div class="scroll">
<table>
<thead>
<tr><th scope="col">Step</th><th scope="col">What it is</th><th scope="col">How it is worked out</th><th scope="col" class="number">Result</th><th scope="col">Source</th></tr>
</thead>
<tbody>
{{- range .Steps}}
<tr{{if .Total}} class="total"{{end}}>
<td>{{.N}}</td>
<td>{{.Label}}{{if .Unit}} <span class="unit">({{.Unit}})</span>{{end}}</td>
<td>{{.How}}</td>
<td class="number" id="out-{{.ID}}">-</td>
<td>{{if .Cite}}<a href="#cite-{{.Cite.ID}}">[{{.Cite.N}}]</a>{{end}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
<p class="hint">Every step uses exact decimal arithmetic. Where a step is rounded, a half is rounded away from zero: 0.125 to 2 decimal places is 0.13.</p>
</section>
{{- if .Constants}}

<section aria-labelledby="h-constants">
<h2 id="h-constants">Fixed values</h2>
<div class="scroll">
<table>
<thead>
<tr><th scope="col">What it is</th><th scope="col" class="number">Value</th><th scope="col">Source</th></tr>
</thead>
<tbody>
{{- range .Constants}}
<tr>
<td>{{.Label}}{{if .Unit}} <span class="unit">({{.Unit}})</span>{{end}}</td>
<td class="number">{{.Value}}</td>
<td>{{if .Cite}}<a href="#cite-{{.Cite.ID}}">[{{.Cite.N}}]</a>{{end}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
</section>
{{- end}}
{{- range .Tables}}

<section aria-labelledby="h-table-{{.ID}}">
<h2 id="h-table-{{.ID}}">{{.Label}}{{if .Unit}} <span class="unit">({{.Unit}})</span>{{end}}{{if .Cite}} <a href="#cite-{{.Cite.ID}}">[{{.Cite.N}}]</a>{{end}}</h2>
<div class="scroll">
<table>
<thead>
<tr><th scope="col">Option</th><th scope="col" class="number">Value</th></tr>
</thead>
<tbody>
{{- range .Rows}}
<tr><td>{{.Label}}</td><td class="number">{{.Value}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
</section>
{{- end}}

<section aria-labelledby="h-sources">
<h2 id="h-sources">Sources</h2>
<ol>
{{- range .Citations}}
<li id="cite-{{.ID}}">{{.Label}}{{if .Note}}. {{.Note}}{{end}}{{if .URL}} <span class="unit">{{.URL}}</span>{{end}}</li>
{{- end}}
</ol>
</section>

<footer>
<p>This page works entirely in your browser. It stores nothing and sends nothing anywhere. <a href="tests/index.html">Run the worked examples</a>.</p>
<p>Generated by Moldloft {{.Generator}} from the <code>calculator</code> template. MIT License.</p>
</footer>
</main>
<script src="js/data.js"></script>
<script src="js/decimal.js"></script>
<script src="js/engine.js"></script>
<script src="js/app.js"></script>
</body>
</html>
