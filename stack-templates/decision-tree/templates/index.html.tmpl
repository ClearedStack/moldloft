<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<main>
<h1>{{.Title}}</h1>
<p class="lede">{{.Summary}}</p>

<section aria-labelledby="h-scope">
<h2 id="h-scope">What this tool does not cover</h2>
<ul>
{{- range .ScopeLimits}}
<li>{{.}}</li>
{{- end}}
</ul>
</section>

<section aria-labelledby="h-inputs">
<h2 id="h-inputs">Decision questions</h2>
<form id="inputs" novalidate autocomplete="off">
{{- range .Questions}}
<div class="field" id="q-{{.ID}}"{{if not .IsStart}} hidden{{end}}>
<label for="in-{{.ID}}">{{.Prompt}} <a href="#cite-{{.Cite.ID}}">[{{.Cite.N}}]</a></label>
<select id="in-{{.ID}}" aria-describedby="hint-{{.ID}}">
<option value="">Choose an option</option>
{{- range .Options}}
<option value="{{.Key}}">{{.Label}}</option>
{{- end}}
</select>
<p class="hint" id="hint-{{.ID}}">{{if .Help}}{{.Help}}{{else}}Select one option to continue.{{end}}</p>
</div>
{{- end}}
<button type="reset">Start over</button>
</form>
</section>

<section aria-labelledby="h-totals">
<h2 id="h-totals">Determination</h2>
<dl class="totals">
<div><dt>Status</dt><dd id="out-status">-</dd></div>
<div><dt>Outcome</dt><dd id="out-outcome">-</dd></div>
<div><dt>Steps answered</dt><dd id="out-steps">0</dd></div>
</dl>
<p class="hint" id="status" aria-live="polite">The decision tree needs JavaScript and has not run.</p>
</section>

<section aria-labelledby="h-sources">
<h2 id="h-sources">Sources</h2>
<ol>
{{- range .Citations}}
<li id="cite-{{.ID}}"><strong>{{.Label}}</strong>{{if .Note}}. {{.Note}}{{end}}{{if .URL}}. <code>{{.URL}}</code>{{end}}</li>
{{- end}}
</ol>
</section>

<footer>
<p><a href="tests/index.html">Check the {{len .Examples}} worked examples</a>. Generated by Moldloft {{.Generator}} under the MIT License. Answers stay in browser memory and are cleared when the page closes or resets.</p>
</footer>
</main>
<script src="js/data.js"></script>
<script src="js/engine.js"></script>
<script src="js/app.js"></script>
</body>
</html>
