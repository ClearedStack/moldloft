<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<main>
<h1>{{.Title}}</h1>
<p class="lede">{{.Summary}}</p>

<section aria-labelledby="h-scope">
<h2 id="h-scope">What this tool does not cover</h2>
<ul>
{{- range .ScopeLimits}}
<li>{{.}}</li>
{{- end}}
</ul>
</section>

<section aria-labelledby="h-rules">
<h2 id="h-rules">Column rules</h2>
<p class="hint">Delimiter: <strong>{{.DelimiterWord}}</strong>. Header row expected: <strong>{{if .HasHeader}}yes{{else}}no{{end}}</strong>.</p>
<div class="scroll">
<table>
<thead>
<tr><th>Column</th><th>Label</th><th>Required</th><th>Rule</th></tr>
</thead>
<tbody>
{{- range .Columns}}
<tr>
<td><code>{{.ID}}</code></td>
<td>{{.Label}} <a href="#cite-{{.Cite.ID}}">[{{.Cite.N}}]</a></td>
<td>{{if .Required}}Yes{{else}}Optional{{end}}</td>
<td>{{.RuleDesc}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
{{- if .Tables}}
{{- range .Tables}}
<p class="hint"><strong>{{.Label}}</strong>{{if .Cite}} <a href="#cite-{{.Cite.ID}}">[{{.Cite.N}}]</a>{{end}}: <code>{{.Codes}}</code></p>
{{- end}}
{{- end}}
</section>

<section aria-labelledby="h-inputs">
<h2 id="h-inputs">Input records</h2>
<form id="inputs" novalidate autocomplete="off">
<div class="field">
<label for="in-file">Load local file <span class="unit">(optional, stays in browser memory)</span></label>
<input id="in-file" type="file" accept=".txt,.csv,.tsv,text/plain">
</div>
<div class="field">
<label for="in-text">Records to validate</label>
<textarea id="in-text" rows="8">{{.SampleInput}}</textarea>
</div>
<button type="reset">Clear records</button>
</form>
</section>

<section aria-labelledby="h-totals">
<h2 id="h-totals">Validation summary</h2>
<dl class="totals">
<div><dt>Status</dt><dd id="out-status">-</dd></div>
<div><dt>Data rows</dt><dd id="out-rows">-</dd></div>
<div><dt>Errors</dt><dd id="out-errors">-</dd></div>
</dl>
<p class="hint" id="status" aria-live="polite">The validator needs JavaScript and has not run.</p>
<ul id="findings"></ul>
</section>

<section aria-labelledby="h-sources">
<h2 id="h-sources">Sources</h2>
<ol>
{{- range .Citations}}
<li id="cite-{{.ID}}"><strong>{{.Label}}</strong>{{if .Note}}. {{.Note}}{{end}}{{if .URL}}. <code>{{.URL}}</code>{{end}}</li>
{{- end}}
</ol>
</section>

<footer>
<p><a href="tests/index.html">Check the {{len .Examples}} worked examples</a>. Generated by Moldloft {{.Generator}} under the MIT License. Records stay in browser memory and are cleared when the page closes or resets.</p>
</footer>
</main>
<script src="js/data.js"></script>
<script src="js/engine.js"></script>
<script src="js/app.js"></script>
</body>
</html>
