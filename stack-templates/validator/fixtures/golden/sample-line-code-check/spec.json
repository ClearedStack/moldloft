{
  "contract_version": "v1",
  "item_id": "PA-0102",
  "tool": {
    "slug": "sample-line-code-check",
    "title": "Sample Line Code Validator",
    "summary": "Validates pipe-delimited line-item schedule records against numeric, code and table rules."
  },
  "pattern": "validator",
  "citations": [
    {
      "id": "handbook_sec_5",
      "label": "Sample Schedule Formatting Guide, Section 5.1",
      "note": "Synthetic public-domain validation rule set used solely as a Moldloft test fixture."
    },
    {
      "id": "handbook_app_b",
      "label": "Sample Schedule Formatting Guide, Appendix B",
      "note": "Synthetic table of allowed unit-of-issue codes."
    }
  ],
  "scope_limits": [
    "Checks syntax, lengths and allowed unit codes only; does not verify pricing reasonableness.",
    "Synthetic fixture rule set, not an active agency schedule instruction."
  ],
  "body": {
    "delimiter": "pipe",
    "has_header": true,
    "tables": [
      {
        "id": "unit_codes",
        "label": "Allowed unit codes",
        "citation": "handbook_app_b",
        "codes": ["EA", "HR", "LOT", "MO"]
      }
    ],
    "columns": [
      {
        "id": "clin",
        "label": "Line item number",
        "required": true,
        "rule": "digits",
        "min_len": 4,
        "max_len": 6,
        "citation": "handbook_sec_5"
      },
      {
        "id": "acct_code",
        "label": "Account code",
        "required": true,
        "rule": "upper_code",
        "min_len": 6,
        "max_len": 10,
        "prefix": "AC-",
        "citation": "handbook_sec_5"
      },
      {
        "id": "unit",
        "label": "Unit of issue",
        "required": true,
        "rule": "in_table",
        "table": "unit_codes",
        "citation": "handbook_app_b"
      },
      {
        "id": "note",
        "label": "Line description",
        "required": false,
        "rule": "text",
        "min_len": 0,
        "max_len": 40,
        "citation": "handbook_sec_5"
      }
    ]
  },
  "worked_examples": [
    {
      "id": "valid_two_rows",
      "label": "Two valid schedule rows",
      "input": "clin|acct_code|unit|note\n0001|AC-1040|EA|Base hardware kit\n0002|AC-2080|HR|",
      "expect": {
        "valid": true,
        "row_count": 2,
        "error_count": 0
      }
    },
    {
      "id": "bad_unit_and_missing_code",
      "label": "Missing account code and unlisted unit code",
      "input": "clin|acct_code|unit|note\n0001||EA|Missing account\n0002|AC-2080|BOX|Unknown unit",
      "expect": {
        "valid": false,
        "row_count": 2,
        "error_count": 2
      }
    }
  ]
}
