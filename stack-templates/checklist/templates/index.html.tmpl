<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>
<main>
<h1>{{.Title}}</h1>
<p class="lede">{{.Summary}}</p>

<section aria-labelledby="h-scope">
<h2 id="h-scope">What this tool does not cover</h2>
<ul>
{{- range .ScopeLimits}}
<li>{{.}}</li>
{{- end}}
</ul>
</section>

<section aria-labelledby="h-inputs">
<h2 id="h-inputs">Checklist items</h2>
<form id="inputs" novalidate autocomplete="off">
{{- range .Items}}
<div class="field">
<label for="in-{{.ID}}">{{.N}}. {{.Label}} {{if .Required}}<span class="unit">(required)</span>{{else}}<span class="unit">(advisory)</span>{{end}} <a href="#cite-{{.Cite.ID}}">[{{.Cite.N}}]</a></label>
<select id="in-{{.ID}}" aria-describedby="hint-{{.ID}} err-{{.ID}}">
<option value="">Choose an answer</option>
<option value="yes">Yes</option>
<option value="no">No</option>
{{- if .AllowNA}}
<option value="na">Not applicable</option>
{{- end}}
</select>
<p class="hint" id="hint-{{.ID}}">{{if .Help}}{{.Help}}{{else}}Select Yes or No{{if .AllowNA}}, or Not applicable{{end}}.{{end}}</p>
<p class="error" id="err-{{.ID}}" aria-live="polite"></p>
</div>
{{- end}}
<button type="reset">Clear all answers</button>
</form>
</section>

<section aria-labelledby="h-totals">
<h2 id="h-totals">Summary</h2>
<dl class="totals">
<div><dt>Status</dt><dd id="out-status">-</dd></div>
<div><dt>Unmet required items</dt><dd id="out-unmet">-</dd></div>
<div><dt>Yes</dt><dd id="out-yes">-</dd></div>
<div><dt>No</dt><dd id="out-no">-</dd></div>
<div><dt>Not applicable</dt><dd id="out-na">-</dd></div>
</dl>
<p class="hint" id="status" aria-live="polite">The checklist needs JavaScript and has not been evaluated.</p>
</section>

<section aria-labelledby="h-sources">
<h2 id="h-sources">Sources</h2>
<ol>
{{- range .Citations}}
<li id="cite-{{.ID}}"><strong>{{.Label}}</strong>{{if .Note}}. {{.Note}}{{end}}{{if .URL}}. <code>{{.URL}}</code>{{end}}</li>
{{- end}}
</ol>
</section>

<footer>
<p><a href="tests/index.html">Check the {{len .Examples}} worked examples</a>. Generated by Moldloft {{.Generator}} under the MIT License. Answers stay in browser memory and are cleared when the page closes or resets.</p>
</footer>
</main>
<script src="js/data.js"></script>
<script src="js/engine.js"></script>
<script src="js/app.js"></script>
</body>
</html>
